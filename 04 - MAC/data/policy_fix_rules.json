  "version": "2.1",
  "description": "Local policy fix rules. Expanded to cover Copyright, Public Figures, Medical, Phobias, and advanced Negative Prompts.",
  "dangerous_phrases": [
    {
      "pattern": "no deformed \\w+",
      "replacement": "",
      "note": "body horror trigger"
    },
    {
      "pattern": "no mutated \\w+",
      "replacement": "",
      "note": "gore/mutation trigger"
    },
    {
      "pattern": "no melting \\w+",
      "replacement": "",
