  "dialogue_strip": {
    "enabled": true,
    "patterns": [
      "(?:saying|speaking|whispering|yelling|shouting|exclaiming|murmuring|crying|chanting|singing)\\s*[,:]?\\s*[\"'][^\"']+[\"']",
      "(?:says|said|whispers|yells|shouts|exclaims|murmurs|cries|chants|sings)\\s*[,:]?\\s*[\"'][^\"']+[\"']",
      "(?:thinking|pondering)\\s*[,:]?\\s*[\"'][^\"']+[\"']"
    ],
    "replacement_template": "expressing {tone} through body language",
    "default_tone": "a natural and fitting emotion"
  },
  "quality_tags": {
    "positive": "Masterpiece quality, flawless anatomy, perfect physical proportions, seamless high-resolution textures, pristine rendering, physically based rendering (PBR), high aesthetic value, cinematic lighting, studio-quality output, highly detailed.",
