      "replacement": "",
      "note": "body horror trigger"
    },
    {
      "pattern": "no (disfigured|dismembered|severed|amputated) \\w+",
      "replacement": "",
      "note": "gore/violence trigger"
    },
    {
      "pattern": "no (blood|bleeding|bloody|gore|gory) \\w*",
      "replacement": "",
      "note": "violence trigger"
    },
    {
      "pattern": "no (naked|nude|nudity|nsfw|sexual|erotic|sensual|seductive) \\w*",
      "replacement": "",
      "note": "NSFW trigger"
    },
    {
      "pattern": "no (dead|death|dying|corpse|cadaver|zombie) \\w*",
      "replacement": "",
      "note": "death/gore trigger"
    },
    {
      "pattern": "no (ugly|grotesque|horrific|terrifying|disturbing) \\w*",
      "replacement": "",
      "note": "negative descriptor trigger"
    },
    {
      "pattern": "no (weapon|weapons|gun|guns|knife|knives|sword|swords) \\w*",
      "replacement": "",
      "note": "weapon/violence trigger"
    },
    {
      "pattern": "no (injury|injuries|wound|wounds|scar|scars) \\w*",
      "replacement": "",
      "note": "injury/violence trigger"
    },
    {
      "pattern": "(?:no|without|avoid|prevent|never)\\s+(?:deform(?:ed|ity)?|mutat(?:ed|ion)?|melt(?:ing|ed)?|distort(?:ed|ion)?)",
      "replacement": "",
      "note": "generic negative quality"
    },
    {
      "pattern": "(?:no|without|avoid)\\s+(?:sudden color shifts?|texture distortion|visual artifacts?|glitch(?:es|ing)?)",
      "replacement": "",
      "note": "technical negative prompt"
    },
    {
      "pattern": "(?:no|without|avoid)\\s+(?:poorly drawn|bad anatomy|bad proportions|unnatural pose)",
      "replacement": "",
      "note": "common negative prompt cleanup"
    },
    {
      "pattern": ",?\\s*and absolutely no texture distortion",
      "replacement": "",
      "note": "common VEO negative suffix"
    },
    {
      "pattern": "\\bno\\s+(?:text|subtitles|labels|watermarks|signatures)(?:\\s*,\\s*no\\s+(?:text|subtitles|labels|watermarks|signatures))*",
      "replacement": "",
      "note": "text/watermark negative (safe to keep but compact)"
    },
    {
      "pattern": "in the style of (?:Disney|Pixar|Marvel|DC|Studio Ghibli|Nintendo)",
      "replacement": "in a highly detailed, premium cinematic animation style",
      "note": "Copyright/IP style trigger"
    },
    {
      "pattern": "(?:holding|pointing|aiming) a (?:gun|rifle|pistol|shotgun|sniper|firearm)",
      "replacement": "holding a dynamic action pose",
      "note": "Action/Violence context trigger"
    },
    {
      "pattern": "(?:child|kid|toddler|baby|girl|boy|infant)\\s+(?:in lingerie|in underwear|naked|nude|bleeding|crying|injured|tied up|bound)",
      "replacement": "happy child playing safely in modest clothing",
      "note": "Strict Child Safety trigger"
    },
    {
      "pattern": "(?:animal|dog|cat|pet)\\s+(?:abuse|fighting|bleeding|dead|injured|suffering)",
      "replacement": "cute animal resting peacefully",
      "note": "Animal welfare trigger"
    },
    {
      "pattern": "no (?:cross-eyed|strabismus|asymmetric|proportions|bad anatomy|poorly drawn face|poorly drawn hands)",
      "replacement": "",
      "note": "Generic negative prompt cleanup"
    },
    {
      "pattern": "(?:plane crash|car crash|car wreck|train derailment|burning building)\\s+(?:with victims|dead bodies|fatal)",
      "replacement": "dramatic action movie set",
      "note": "Disaster/Tragedy trigger"
    },
    {
      "pattern": "blood(?:stains|spatter|splatter|pool|dripping)",
      "replacement": "red paint splatters",
      "note": "Visual gore trigger"
    }
  ],
